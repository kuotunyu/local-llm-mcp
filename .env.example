# Copy to .env and fill in as needed. Never commit the real .env.

# Ollama server address (default assumes Ollama runs inside the same WSL2 distro as this server).
OLLAMA_HOST=http://127.0.0.1:11434

# Default model for tools that don't specify one explicitly.
# TAIDE (Taiwan LLM project) — a zh-TW-tuned model, picked over a generic
# multilingual model of similar size because this project targets zh-TW work.
LOCAL_LLM_MCP_DEFAULT_MODEL=cwchang/llama3-taide-lx-8b-chat-alpha1

# httpx client timeouts (seconds). Ollama's own Python client defaults to no timeout — never rely on that.
LOCAL_LLM_MCP_CONNECT_TIMEOUT=5
LOCAL_LLM_MCP_READ_TIMEOUT=300

# Per-tool input length caps (characters).
LOCAL_LLM_MCP_MAX_PROMPT_CHARS=8000
LOCAL_LLM_MCP_MAX_SUMMARIZE_CHARS=200000

# Context window requested per Ollama call. Ollama's own default is not trustworthy
# (docs disagree: 2048 vs 4096 vs VRAM-tiered) — always set explicitly.
LOCAL_LLM_MCP_NUM_CTX=8192

# --- Streamable HTTP transport (Phase 3) ---
# Which transport `local-llm-mcp` runs by default; overridden by --transport on the CLI.
LOCAL_LLM_MCP_TRANSPORT=stdio
LOCAL_LLM_MCP_HTTP_HOST=127.0.0.1
LOCAL_LLM_MCP_HTTP_PORT=8000
LOCAL_LLM_MCP_HTTP_PATH=/mcp

# Required only for the Streamable HTTP transport. Leave unset for stdio — the server
# refuses to start the HTTP transport without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LOCAL_LLM_MCP_API_KEY=

# --- Optional: web_search tool (hybrid privacy routing) ---
# The one tool that deliberately leaves the machine: web_search sends its query to
# the Felo cloud API and returns a cited answer (felo.ai → Settings → API Keys).
# Leave unset to disable — every *_private tool keeps working locally without it.
FELO_API_KEY=
# LOCAL_LLM_MCP_FELO_API_URL=https://openapi.felo.ai/v2/chat
# LOCAL_LLM_MCP_FELO_READ_TIMEOUT=120
